# Built web UI assets are generated by `npm run build` and embedded into the
# wheel / standalone build. Store and check them out byte-for-byte so that
# core.autocrlf never produces spurious diffs (or hash drift) on Windows.
src/ontotator/web/** -text -diff

# Binary test fixtures
*.zip binary
*.sqlite binary
*.sqlite3 binary

# Translation files (babelon TSV) are hashed byte-wise for the index identity.
# Check them out as they are stored, so core.autocrlf does not give the
# fixtures other line ends, and with them another identity, on Windows.
*.tsv -text

# Shell scripts run in Git Bash on Windows too; a CR at the line end breaks them.
*.sh text eol=lf

# PostgreSQL bootstrap validates these public DEVELOPMENT ONLY fixtures as hex.
docker/dev-passwords/* text eol=lf

# Keep bundled Fontsource licence copies byte-identical on Windows checkouts.
frontend/public/licenses/*.txt text eol=lf

# Vite copies index.html verbatim into the embedded bundle; CRLF here would make
# the Windows build differ from the Linux CI build.
frontend/index.html text eol=lf

# Tests pin the SHA-256 of this ontology fixture; it is stored with CRLF line
# ends, so every checkout (Linux CI and Windows) gets the same bytes.
tests/fixtures/hp.json -text
