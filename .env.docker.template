# Private deployment settings. Do not put secrets here.
#   cp .env.docker.template .env.docker
#   ln -sf .env.docker .env   # Docker Compose reads .env by default
# Production: verified application image, pinned by the digest that
# scripts/publish-image.sh prints.
ONTOTATOR_IMAGE=ghcr.io/janpower/ontotator@sha256:REPLACE_WITH_VERIFIED_DIGEST
ONTOTATOR_PUBLIC_ORIGIN=https://editor.example.org
# Existing external Nginx Proxy Manager network (check: docker network ls).
NPM_SHARED_NETWORK_NAME=npm_default
# Fixed IP of the NPM container on that network, comma-separated if several.
# Never *, never a subnet: other stacks on the shared network could spoof
# X-Forwarded-For.
ONTOTATOR_TRUSTED_PROXIES=172.30.0.10
ONTOTATOR_WORKERS=2

# Development only: BuildKit reads this token file; it is not an image ARG.
GITHUB_TOKEN_FILE=/absolute/path/to/read-only-github-token

# Fixed production service environment (set by docker-compose.yml):
# ONTOTATOR_ENV=production
# ONTOTATOR_DATA_DIR=/data
# ONTOTATOR_DATABASE_URL=postgresql://ontotator_app@ontotator_postgres:5432/ontotator
# ONTOTATOR_DATABASE_PASSWORD_FILE=/run/secrets/app-password
# ONTOTATOR_ADMIN_PASSWORD_HASH_FILE=/run/secrets/admin-password-hash
# ONTOTATOR_MIGRATION_DATABASE_URL=postgresql://ontotator_owner@ontotator_postgres:5432/ontotator
# ONTOTATOR_MIGRATION_DATABASE_PASSWORD_FILE=/run/secrets/owner-password
# POSTGRES_DB=ontotator
# POSTGRES_USER=ontotator_bootstrap
# POSTGRES_PASSWORD_FILE=/run/postgres/bootstrap-password
# Keep matching database role passwords in these separate host directories:
# secrets/postgres/{bootstrap-password,owner-password,app-password}: UID/GID 70:70
# secrets/migrate/{owner-password}: UID/GID 1001:1001 (image service user)
# secrets/app/{app-password,admin-password-hash}: UID/GID 1001:1001
# Every file must be mode 0600, owned by its consuming service UID.
# Generate database passwords as hex, e.g. openssl rand -hex 32.
# Generate the admin Argon2id hash with `ontotator admin hash-password`.
# Never mount owner-password or bootstrap-password in the app container.
# Dev overrides ENV, PUBLIC_ORIGIN, DATABASE_URL, ADMIN_PASSWORD_HASH and
# MIGRATION_DATABASE_URL inline; its disposable passwords must not be reused.
